# FinFlow AI - Environment Configuration

# Server
PORT=5001
NODE_ENV=development

# MongoDB Database
# Leave blank to automatically use zero-config embedded in-memory MongoDB
# Or provide your MongoDB Atlas connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/finflow?retryWrites=true&w=majority
MONGODB_URI=

# AI Engine (Google Gemini / OpenAI)
# Optional: Provide Gemini API key. If omitted, FinFlow runs its high-precision local forensic engine fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# CORS Allowed Origins
CORS_ORIGIN=*
